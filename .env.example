# Base de datos
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=byteredapp

# Redis (blocklist JWT persistente)
# Si se deja vacio, la blocklist se mantiene en memoria (se pierde al reiniciar)
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0

# JWT — CAMBIA ESTO EN PRODUCCION
# Genera un secreto seguro con: python scripts/generate_secret.py
JWT_SECRET=changeme
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend — URL publica de la SPA
VITE_API_URL=http://localhost:8000/api/v1

# Email (para tickets) — OPCIONAL: si se deja vacio, los tickets
# se guardan pero NO se envian correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TICKETS_EMAIL=admin@byteredapp.com
