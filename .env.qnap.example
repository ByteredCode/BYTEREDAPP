# === Cloudflare Tunnel ===
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_cloudflare_tunnel_aqui

# === Base de datos (Hostinger MySQL) ===
MYSQL_HOST=IP_de_tu_servidor_hostinger
MYSQL_USER=tu_usuario_mysql
MYSQL_PASSWORD=tu_password_mysql
MYSQL_DATABASE=tu_nombre_bd

# === JWT (generar con: python scripts/generate_secret.py) ===
JWT_SECRET=cambiar_con_secret_generado

# === Email ===
RESEND_API_KEY=tu_api_key_de_resend_aqui
