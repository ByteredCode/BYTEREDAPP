{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "agente-general",
  "instructions": [
    "ia/AGENTS.md",
    "ia/architecture.md"
  ],
  "agent": {
    "agente-general": {
      "description": "Orquestador full-stack — coordina tareas y delega a subagentes especializados",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "webfetch": "allow"
      }
    },
    "agente-frontend": {
      "description": "Especialista en React/JS/CSS — solo trabaja en client/",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": { "client/**": "allow", "*": "deny" },
        "grep": { "client/**": "allow", "*": "deny" },
        "bash": { "cd client*": "allow", "pnpm *": "allow", "*": "ask" }
      }
    },
    "agente-backend": {
      "description": "Especialista en FastAPI/Python — solo trabaja en server/",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": { "server/**": "allow", "*": "deny" },
        "grep": { "server/**": "allow", "*": "deny" },
        "bash": { "cd server*": "allow", "pip *": "allow", "uvicorn *": "allow", "*": "ask" }
      }
    },
    "agente-bd": {
      "description": "Especialista en MySQL/SQL — migraciones, consultas, esquemas",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": { "server/app/models/**": "allow", "server/alembic/**": "allow", "*": "deny" },
        "grep": { "server/**": "allow", "*": "deny" },
        "bash": { "alembic *": "allow", "docker *": "allow", "*": "ask" }
      }
    },
    "agente-profesor": {
      "description": "Profesor universitario de programación. Invócalo cuando quieras aprender sobre cualquier parte del código. Solo explica, no modifica nada ni ejecuta comandos.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },
    "agente-comentador": {
      "description": "Comentador de código — cuando se le invoca, añade comentarios didácticos en español a archivos de código del proyecto (backend y frontend). No modifica lógica, solo documenta.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny"
      }
    },
    "agente-ciberseguridad": {
      "description": "Especialista en ciberseguridad OWASP. Audita, analiza y corrige vulnerabilidades en backend y frontend según OWASP Top 10. Propone contra medidas y buenas prácticas.",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": { "pip *": "allow", "npm *": "allow", "pnpm *": "allow", "pytest *": "allow", "python *": "allow", "docker *": "allow", "*": "ask" },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow"
      }
    }
  }
}
